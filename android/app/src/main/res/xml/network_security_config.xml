<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Glyph Folio talks to a self-hosted server, usually plain HTTP on a LAN or Tailscale. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
